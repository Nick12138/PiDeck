{
  "name": "@pideck/pi-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "bin": {
    "pideck-host": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "spike:sidecar": "tsx src/spike/sidecar-extension-spike.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@earendil-works/pi-tui": "0.82.1",
    "@pideck/protocol": "workspace:*",
    "minimatch": "10.2.5",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@pideck-test/rpiv-ask-user-question-v1": "npm:@juicesharp/rpiv-ask-user-question@1.20.0",
    "@pideck-test/rpiv-ask-user-question-v2": "npm:@juicesharp/rpiv-ask-user-question@2.1.0",
    "@types/node": "24.12.4",
    "@types/proper-lockfile": "4.1.4",
    "tsx": "4.20.3",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
